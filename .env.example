# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is listed in .gitignore and must NEVER be committed.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-sonnet-5-5
LLM_FALLBACK_MODEL=claude-haiku-5-5
ROUTER_MODEL=claude-haiku-5-5
# llm = LLM classifier with rule-based fallback; rules = rules only (no API call)
ROUTER_MODE=llm

# --- PostgreSQL (used by docker-compose AND by the Flask server) ---
POSTGRES_DB=souschef
POSTGRES_USER=souschef
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.35
# Ingest data/recipes automatically on server start if the vector table is empty
AUTO_INGEST=true

# --- Server ---
SERVER_PORT=5000
MEMORY_TURNS=6
